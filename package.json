{
  "name": "passManDemo",
  "version": "1.5.0",
  "description": "Backend for passMan Demo",
  "main": "server.js",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.19.0 <21",
    "npm": ">=10 <11"
  },
  "scripts": {
    "start": "node backend/server",
    "server": "nodemon backend/server",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test:frontend": "npm test --prefix frontend -- --watchAll=false --passWithNoTests",
    "build:frontend": "npm run build --prefix frontend",
    "verify": "npm run test:frontend && npm run build:frontend",
    "data:import": "node backend/seeder",
    "data:destroy": "node backend/seeder -d",
    "refresh": "concurrently \"npm run data:destroy\" \"npm run data:import\" \"npm run dev\"",
    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false npm install --prefix frontend && npm run build --prefix frontend"
  },
  "author": "Toan",
  "license": "ISC",
  "dependencies": {
    "algoliasearch": "^4.20.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.0",
    "config": "^3.3.6",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-async-handler": "^1.1.4",
    "faker": "^5.5.3",
    "final-form": "^4.20.7",
    "jsonwebtoken": "^8.5.1",
    "md5": "^2.3.0",
    "mongoose": "^5.13.3",
    "react-final-form": "^6.5.9",
    "react-final-form-listeners": "^1.0.3",
    "uuid": "^8.3.2",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "concurrently": "^6.2.0",
    "nodemon": "^2.0.12"
  }
}
